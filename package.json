{
  "name": "quiz-app",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "pnpm dev:prepare && pnpm --parallel --filter @quiz/web --filter @quiz/api dev",
    "dev:prepare": "docker compose up -d postgres && pnpm db:migrate && pnpm db:seed-admin",
    "build": "pnpm --filter @quiz/web build && pnpm --filter @quiz/api build",
    "typecheck": "pnpm --recursive typecheck",
    "db:generate": "pnpm --filter @quiz/api db:generate",
    "db:migrate": "pnpm --filter @quiz/api db:migrate",
    "db:seed-admin": "pnpm --filter @quiz/api db:seed-admin",
    "release:publish": "node scripts/publish-images.mjs",
    "release:publish:api": "node scripts/publish-images.mjs --service api",
    "release:publish:web": "node scripts/publish-images.mjs --service web"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "dotenv": "^18.0.10"
  }
}
